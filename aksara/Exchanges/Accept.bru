meta {
  name: Accept
  type: http
  seq: 5
}

post {
  url: {{url}}/api/exchanges/{{exchangeId}}/accept/
  body: json
  auth: inherit
}

body:json {
  {
    "meetup_location": {{locationId}},
    "meetup_time": "2030-01-15T14:00:00Z"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Seller only, while `pending`. Needs an active meetup location and a future time
  (ISO 8601). Reserves the listing, and the offered book in a swap.

  Responses:
  - `200`: the exchange
  - `400`: listing no longer available, or time in the past
  - `401`: sign in required (run **Accounts / Login**)
  - `403`: not the seller
}
