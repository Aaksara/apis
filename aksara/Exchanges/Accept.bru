meta {
  name: Accept
  type: http
  seq: 5
}

post {
  url: {{url}}/api/exchanges/{{exchangeId}}/accept/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Seller only, while `pending`. No body. Reserves the listing, and the offered book in a
  swap. The two students then agree where and when to meet in the chat
  (**Exchange chat**).

  Responses:
  - `200`: the exchange
  - `400`: listing no longer available
  - `401`: sign in required (run **Accounts / Login**)
  - `403`: not the seller
}
