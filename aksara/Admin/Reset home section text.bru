meta {
  name: Reset home section text
  type: http
  seq: 25
}

delete {
  url: {{url}}/api/admin/home-sections/how_it_works/content/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Removes the admin's text for one section, so it shows the site's built-in text again.

  Responses:
  - `200`: the section, with `content: {}`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
  - `404`: no such section
}
