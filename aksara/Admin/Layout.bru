meta {
  name: Layout
  type: http
  seq: 14
}

get {
  url: {{url}}/api/admin/layouts/web/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  The live home-page sections of a platform (`web` or `mobile`) and the release that published them.

  Responses:
  - `200`: `{"platform", "version", "published_at", "published_by", "sections": [{id, kind, display_title,
    anchor_id, is_enabled, variant}]}`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
  - `404`: unknown platform
}
