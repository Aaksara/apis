meta {
  name: List meetup locations
  type: http
  seq: 16
}

get {
  url: {{url}}/api/admin/meetup-locations/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Every meetup spot, retired ones included, active first. Not paginated.

  Responses:
  - `200`: `[{id, name, description, is_active}]`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
