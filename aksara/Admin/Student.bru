meta {
  name: Student
  type: http
  seq: 2
}

get {
  url: {{url}}/api/admin/students/{{studentId}}/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  One student, plus their five latest listings. All of them: **Student listings**.

  Responses:
  - `200`: Student with `recent_listings`: up to five rows shaped as in **Student listings**
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
  - `404`: no such student
}
