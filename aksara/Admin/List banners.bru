meta {
  name: List banners
  type: http
  seq: 9
}

get {
  url: {{url}}/api/admin/banners/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Every banner, drafts included, in display order. Not paginated.

  Responses:
  - `200`: `[Banner]`. Banner: `id, title, target_url, image, image_width, image_height, alt_text,
    placement (hero|promotion|footer), status (draft|published), position, updated_at`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
