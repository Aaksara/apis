meta {
  name: Reorder slides
  type: http
  seq: 12
}

post {
  url: {{url}}/api/admin/slides/reorder/
  body: json
  auth: inherit
}

body:json {
  {
    "ids": [{{slideId}}]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Sets the display order. `ids` must list every slide exactly once.

  Responses:
  - `200`: `[Slide]` in the new order
  - `400`: `{"ids": "Send every slide id exactly once."}`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
