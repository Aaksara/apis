meta {
  name: List slides
  type: http
  seq: 9
}

get {
  url: {{url}}/api/admin/slides/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Every home page slide, hidden ones included, in display order. Not paginated.

  Responses:
  - `200`: `[Slide]`. Slide: `{id, caption, link, image, alt_text, is_published, position, updated_at}`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
