meta {
  name: Suspend student
  type: http
  seq: 5
}

post {
  url: {{url}}/api/admin/students/{{studentId}}/suspend/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Blocks sign-in and revokes every refresh token. Access tokens expire within minutes.

  Responses:
  - `200`: the updated student, as in **Student**
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
