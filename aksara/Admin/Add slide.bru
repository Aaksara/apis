meta {
  name: Add slide
  type: http
  seq: 10
}

post {
  url: {{url}}/api/admin/slides/
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  slider: home_hero
  caption: Find the books for your course
  link: https://akshara.app/spring
  alt_text: Students swapping books
  is_published: true
  image: @file()
}

script:post-response {
  if (res.status === 201) bru.setVar("slideId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Multipart. `image` is required, PNG/JPEG/WebP up to 4 MB; set the file path in the Body tab.
  `slider` defaults to home_hero. `link` is optional and must be `http(s)://`.
New slides go last in their slider.

  Responses:
  - `201`: Slide
  - `400`: field errors
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
