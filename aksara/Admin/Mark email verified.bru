meta {
  name: Mark email verified
  type: http
  seq: 7
}

post {
  url: {{url}}/api/admin/students/{{studentId}}/verify-email/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Marks the email verified without the emailed link, e.g. after an ID check.

  Responses:
  - `200`: the updated student, as in **Student**
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
