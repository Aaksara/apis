meta {
  name: Update slide
  type: http
  seq: 11
}

patch {
  url: {{url}}/api/admin/slides/{{slideId}}/
  body: json
  auth: inherit
}

body:json {
  {
    "is_published": false
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Multipart or JSON. Send only the fields to change. A new `image` replaces and deletes the old one.
A slide moved to another `slider` goes last there.

  Responses:
  - `200`: Slide
  - `400`: field errors
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
