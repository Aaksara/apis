meta {
  name: Delete slide
  type: http
  seq: 13
}

delete {
  url: {{url}}/api/admin/slides/{{slideId}}/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Deletes the slide and its image file.

  Responses:
  - `204`: deleted
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
}
