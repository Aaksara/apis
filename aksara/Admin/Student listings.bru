meta {
  name: Student listings
  type: http
  seq: 22
}

get {
  url: {{url}}/api/admin/students/{{studentId}}/listings/?status=&page=1
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Every listing the student has posted, newest first, paginated. `status`: `available`,
  `reserved`, `completed` or `withdrawn`; leave it empty for all.

  Responses:
  - `200`: `{"count", "next", "previous", "results": [{id, title, authors, course_code, condition,
    listing_type, price, status, request_count, created_at}]}`. `request_count`
    counts exchange requests in any state.
  - `400`: unknown `status`
  - `401`: sign in required (run **Accounts / Login** as the super admin)
  - `403`: not the super admin
  - `404`: no such student
}
