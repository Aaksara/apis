meta {
  name: Update listing
  type: http
  seq: 5
}

patch {
  url: {{url}}/api/listings/{{listingId}}/
  body: json
  auth: inherit
}

body:json {
  {
    "price": "20.00"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Seller only. The book cannot be changed. `status` can only be set to `available` or
  `withdrawn`, and not while the listing is part of an exchange. Withdrawing rejects
  pending requests for it and cancels requests that offer it in a swap.

  Responses:
  - `200`: the listing
  - `400`: / `403` not the seller
  - `401`: sign in required (run **Accounts / Login**)
}
