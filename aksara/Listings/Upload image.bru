meta {
  name: Upload image
  type: http
  seq: 7
}

post {
  url: {{url}}/api/listings/{{listingId}}/images/
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  image: @file()
}

script:post-response {
  if (res.status < 300) bru.setVar("imageId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Seller only. Multipart field `image`, max 5 MB, at most 5 images per listing.
  Set the file path in the Body tab.

  Responses:
  - `201`: `{"id": 1, "image": "http://.../media/listings/...", "uploaded_at": "..."}`
  - `401`: sign in required (run **Accounts / Login**)
}
