meta {
  name: Get listing
  type: http
  seq: 4
}

get {
  url: {{url}}/api/listings/{{listingId}}/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Open to visitors, who get `seller: null`.

  Responses:
  - `200`: the listing
  - `404`: unknown, or withdrawn and not the viewer's
}
