meta {
  name: Create listing
  type: http
  seq: 3
}

post {
  url: {{url}}/api/listings/
  body: json
  auth: inherit
}

body:json {
  {
    "title": "Principles of Management",
    "authors": "Kishor Bahadur Pradhan",
    "edition": "3rd",
    "condition": "good",
    "listing_type": "sell",
    "price": "450",
    "course_code": "MGT201",
    "description": "Some highlighting."
  }
}

script:post-response {
  if (res.status < 300) bru.setVar("listingId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Name the book in one of two ways:
  - by its details: `title` (required), `authors`, `edition`. A catalogue book with the same
    details, compared ignoring case and extra spaces, is reused; otherwise one is added. Most
    local textbooks have no ISBN, so this is how the app lists books.
  - or by `book_id`, a catalogue book, e.g. from **Books / Lookup by ISBN**.

  Required: the book, `condition`. `listing_type` defaults to `sell`, which needs a `price`.
  Optional: `description`, `course_code` (stored upper-case), `preferred_location` (an active
  meetup location id).

  Responses:
  - `201`: the listing
  - `400`: field errors, e.g. `{"price": ["A selling price above 0 is required. ..."]}`,
    `{"title": ["Give the book's title."]}`, or `book_id` given together with the details
  - `401`: sign in required (run **Accounts / Login**)
}
