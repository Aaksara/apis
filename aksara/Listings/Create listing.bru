meta {
  name: Create listing
  type: http
  seq: 3
}

post {
  url: {{url}}/api/listings/
  body: json
  auth: inherit
}

body:json {
  {
    "book_id": {{bookId}},
    "condition": "good",
    "listing_type": "sell",
    "price": "25.00",
    "course_code": "CS101",
    "description": "Some highlighting."
  }
}

script:post-response {
  if (res.status < 300) bru.setVar("listingId", res.body.id);
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Required: `book_id`, `condition`. `listing_type` defaults to `sell`, which needs a `price`.
  Optional: `description`, `course_code` (stored upper-case), `preferred_location` (an active
  meetup location id).

  Responses:
  - `201`: the listing
  - `400`: field errors, e.g. `{"price": ["A selling price above 0 is required. ..."]}`
  - `401`: sign in required (run **Accounts / Login**)
}
