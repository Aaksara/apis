meta {
  name: Published banners
  type: http
  seq: 1
}

get {
  url: {{url}}/api/cms/banners/?placement=hero
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Published banners in display order. No sign-in needed. Optional `placement`: hero,
  promotion, footer.

  Responses:
  - `200`: `[{id, title, target_url, image, alt_text, placement}]`
}
