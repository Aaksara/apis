meta {
  name: Published slides
  type: http
  seq: 1
}

get {
  url: {{url}}/api/cms/slides/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  The home page's published slides, in display order. No sign-in needed.

  Responses:
  - `200`: `[{id, caption, link, image, alt_text}]`
}
