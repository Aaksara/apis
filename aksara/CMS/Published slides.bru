meta {
  name: Published slides
  type: http
  seq: 1
}

get {
  url: {{url}}/api/cms/slides/?slider=home_hero
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  A slider's published slides, in display order. No sign-in needed. `slider`: home_hero,
  home_safety or sign_in; leave it out for all of them.

  Responses:
  - `200`: `[{id, slider, caption, link, image, alt_text}]`
}
