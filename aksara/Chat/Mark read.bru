meta {
  name: Mark read
  type: http
  seq: 6
}

post {
  url: {{url}}/api/conversations/{{conversationId}}/read/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Marks the other person's messages as read.

  Responses:
  - `200`: `{"marked_read": 3}`
  - `401`: sign in required (run **Accounts / Login**)
}
