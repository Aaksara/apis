meta {
  name: Confirm password reset
  type: http
  seq: 11
}

post {
  url: {{url}}/api/auth/password/reset/confirm/
  body: json
  auth: none
}

body:json {
  {
    "uid": "{{uid}}",
    "token": "{{email_token}}",
    "new_password": "An0ther-good-pass"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Public. `uid` and `token` come from the reset email (environment: `uid`, `email_token`).
  Revokes every session.

  Responses:
  - `200`: `{"detail": "Password has been reset."}`
  - `400`: `{"detail": "Invalid or expired link."}` or `{"new_password": [...]}`
}
