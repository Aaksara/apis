meta {
  name: Update me
  type: http
  seq: 8
}

patch {
  url: {{url}}/api/auth/me/
  body: json
  auth: inherit
}

body:json {
  {
    "department": "Computer Science"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Editable: `full_name`, `student_id`, `department`, `phone`, `avatar` (image upload, max
  5 MB, send as multipart). `email` and `is_email_verified` are read-only.

  Responses:
  - `200`: the updated user
  - `401`: sign in required (run **Accounts / Login**)
}
