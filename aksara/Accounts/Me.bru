meta {
  name: Me
  type: http
  seq: 7
}

get {
  url: {{url}}/api/auth/me/
  body: none
  auth: inherit
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  The signed-in user.

  Responses:
  - `200`: User: `id, email, full_name, student_id, department, phone, avatar, is_email_verified, date_joined`
  - `401`: sign in required (run **Accounts / Login**)
}
