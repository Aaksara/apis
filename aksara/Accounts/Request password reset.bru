meta {
  name: Request password reset
  type: http
  seq: 10
}

post {
  url: {{url}}/api/auth/password/reset/
  body: json
  auth: none
}

body:json {
  {
    "email": "{{email}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Public. Emails a link to `{FRONTEND_URL}/auth/reset-password?uid=...&token=...`. Always
  `200` with the same message, whether or not the account exists.
}
