meta {
  name: Change password
  type: http
  seq: 9
}

post {
  url: {{url}}/api/auth/password/change/
  body: json
  auth: inherit
}

body:json {
  {
    "current_password": "{{password}}",
    "new_password": "An0ther-good-pass"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  Signs out every other session (all refresh tokens are revoked).

  Responses:
  - `200`: `{"detail": "Password changed."}`
  - `400`: `{"current_password": ["Current password is incorrect."]}` or password-strength errors
  - `401`: sign in required (run **Accounts / Login**)
}
